<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER BIRU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_kontak">

                <!-- STATUS PERANGKAT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9.41"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●  Wi-Fi  ▰"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- TOMBOL KEMBALI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp">

                    <ImageView
                        android:id="@+id/btnBackKontak"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_left"
                        android:contentDescription="Kembali"/>
                </LinearLayout>

                <!-- JUDUL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kontak Akun"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Atur kontak untuk verifikasi dan pemulihan akun."
                        android:textColor="#DFEDFF"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- KONTEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="28dp">

                <!-- CATATAN INFORMASI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_note_kontak">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ⓘ"
                        android:textColor="#185FA5"
                        android:textSize="17sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Kontak dan status verifikasi di layar ini adalah contoh, bukan data kontak asli Alfi."
                        android:textColor="#185FA5"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- PANEL ALAMAT EMAIL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_panel_kontak">

                    <!-- JUDUL DAN UBAH -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Alamat email"
                            android:textColor="#182D44"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/btnUbahEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah"
                            android:textColor="#2879C7"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Email"
                        android:textColor="#182D44"
                        android:textSize="13sp"
                        android:textStyle="bold"/>


                    <!-- INPUT EMAIL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_input_kontak">

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Masukkan alamat email"
                            android:textColor="#182D44"
                            android:textColorHint="#9AA8B8"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:background="@android:color/transparent"
                            android:padding="0dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✉"
                            android:textColor="#63758A"
                            android:textSize="16sp"/>
                    </LinearLayout>

                    <!-- STATUS EMAIL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textColor="#247A62"
                            android:textSize="15sp"/>

                        <TextView
                            android:id="@+id/tvStatusEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="Terverifikasi · contoh"
                            android:textColor="#247A62"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_verified"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Email ini digunakan untuk bantuan akses akun."
                        android:textColor="#63758A"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- PANEL NOMOR HANDPHONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_panel_kontak">

                    <!-- JUDUL DAN UBAH -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nomor handphone"
                            android:textColor="#182D44"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/btnUbahNomor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah"
                            android:textColor="#2879C7"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Nomor HP"
                        android:textColor="#182D44"
                        android:textSize="13sp"
                        android:textStyle="bold"/>


                    <!-- INPUT NOMOR HP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_input_kontak">

                        <EditText
                            android:id="@+id/etNomorHP"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Masukkan nomor HP"
                            android:textColor="#182D44"
                            android:textColorHint="#9AA8B8"
                            android:textSize="14sp"
                            android:inputType="phone"
                            android:singleLine="true"
                            android:background="@android:color/transparent"
                            android:padding="0dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▯"
                            android:textColor="#63758A"
                            android:textSize="17sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Nomor disamarkan untuk tampilan contoh."
                        android:textColor="#63758A"
                        android:textSize="12sp"/>

                    <!-- STATUS NOMOR HP -->
                    <TextView
                        android:id="@+id/tvStatusNomor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="Belum terverifikasi · contoh"
                        android:textColor="#91621B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_status_pending"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Verifikasi nomor Anda untuk menerima kode konfirmasi akun."
                        android:textColor="#63758A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                    <!-- VERIFIKASI NOMOR -->
                    <Button
                        android:id="@+id/btnVerifikasiNomor"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:text="Verifikasi nomor HP"
                        android:textColor="#2879C7"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/bg_button_outline_kontak"/>
                </LinearLayout>

                <!-- CATATAN KEAMANAN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:background="@drawable/bg_note_kontak">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♧"
                        android:textColor="#185FA5"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Jangan bagikan kode verifikasi kepada siapa pun, termasuk pihak yang mengaku petugas."
                        android:textColor="#185FA5"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- SIMPAN KONTAK -->
                <Button
                    android:id="@+id/btnSimpanKontak"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Simpan kontak akun"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_primary_kontak"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- INDIKATOR BAWAH -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#F5F7FC">

        <View
            android:layout_width="134dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_home_indicator"/>
    </FrameLayout>

</LinearLayout>
