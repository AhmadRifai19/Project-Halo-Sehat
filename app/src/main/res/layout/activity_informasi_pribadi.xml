<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER BIRU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_informasi">

                <!-- Ruang status perangkat, tanpa jam dan baterai -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"/>

                <!-- Tombol kembali -->
                <ImageView
                    android:id="@+id/btnBackInformasi"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="Kembali"/>

                <!-- Judul -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Informasi Pribadi"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Lengkapi data dasar Anda agar profil tetap akurat."
                        android:textColor="#DFEDFF"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"/>

                </LinearLayout>
            </LinearLayout>

            <!-- KONTEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="28dp">

                <!-- PROFIL PEMILIK -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgFotoInformasi"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:background="@drawable/bg_profile_circle"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:contentDescription="Foto profil"/>

                    <TextView
                        android:id="@+id/tvNamaProfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Alfi Mariani"
                        android:textColor="#182D44"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profil saya"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#185FA5"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_status_profil"/>

                </LinearLayout>

                <!-- CARD DATA PRIBADI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card_informasi">

                    <!-- Judul kartu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Data pribadi"
                            android:textColor="#182D44"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvEditData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit data"
                            android:textColor="#2879C7"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>

                    <!-- NAMA LENGKAP -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Nama lengkap"
                        android:textColor="#182D44"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_input_informasi">

                        <EditText
                            android:id="@+id/etNamaLengkapInformasi"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:text="Alfi Mariani"
                            android:textColor="#182D44"
                            android:textSize="15sp"
                            android:singleLine="true"
                            android:inputType="textPersonName"
                            android:padding="0dp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_edit_informasi"
                            android:contentDescription="Edit nama"/>

                    </LinearLayout>

                    <!-- TANGGAL LAHIR -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Tanggal lahir"
                        android:textColor="#182D44"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:id="@+id/btnPilihTanggal"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_input_informasi"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvTanggalLahir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Belum diisi"
                            android:textColor="#63758A"
                            android:textSize="15sp"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_calendar_informasi"
                            android:contentDescription="Pilih tanggal"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pilih tanggal, bulan, dan tahun kelahiran."
                        android:textColor="#63758A"
                        android:textSize="12sp"/>

                    <!-- JENIS KELAMIN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Jenis kelamin"
                        android:textColor="#182D44"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <Spinner
                        android:id="@+id/spJenisKelaminInformasi"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/bg_input_informasi"
                        android:spinnerMode="dropdown"/>

                </LinearLayout>

                <!-- CATATAN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="14dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_note_informasi">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_info_informasi"
                        android:contentDescription="Informasi"/>

                    <TextView
                        android:id="@+id/tvCatatanInformasi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Tanggal lahir dan jenis kelamin belum tersedia. Isi sesuai data Anda, bukan data contoh."
                        android:textColor="#185FA5"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                </LinearLayout>

                <!-- PERINGATAN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Periksa kembali informasi sebelum menyimpan perubahan."
                    android:textColor="#63758A"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"/>

                <!-- TOMBOL SIMPAN -->
                <Button
                    android:id="@+id/btnSimpanInformasi"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Simpan informasi pribadi"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_informasi"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- HOME INDICATOR -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#F5F7FC">

        <View
            android:layout_width="134dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_home_indicator"/>

    </FrameLayout>

</LinearLayout>
