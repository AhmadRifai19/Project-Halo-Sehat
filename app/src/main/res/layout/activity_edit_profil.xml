<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <!-- SEMUA KONTEN DAPAT DI-SCROLL -->
    <ScrollView
        android:id="@+id/scrollEditProfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER BIRU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_edit">

                <!-- Tombol Kembali -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_left"
                        android:contentDescription="Kembali" />
                </LinearLayout>

                <!-- Judul Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edit Profil"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Kelola profil untuk pengalaman kesehatan yang lebih personal."
                        android:textColor="#DFEDFF"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- KONTEN PROFIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="28dp">

                <!-- FOTO PROFIL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="163dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgFotoProfil"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_profile_circle"
                        android:clipToOutline="true"
                        android:contentDescription="Foto profil" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_camera"
                            android:contentDescription="Kamera" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Ubah foto profil"
                            android:textColor="#2879C7"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Alfi Mariani"
                        android:textColor="#182D44"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- PROFIL YANG DITAMPILKAN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card_edit">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profil yang ditampilkan"
                        android:textColor="#182D44"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Nama tampilan"
                        android:textColor="#182D44"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etNamaTampilan"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_input_edit"
                        android:text="Alfi Mariani"
                        android:textColor="#182D44"
                        android:textSize="15sp"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Nama ini ditampilkan di profil Anda."
                        android:textColor="#63758A"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- DATA PROFIL TERKAIT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card_edit">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Data profil terkait"
                        android:textColor="#182D44"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- INFORMASI PRIBADI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="43dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="9dp"
                            android:background="@drawable/bg_icon_edit"
                            android:src="@drawable/ic_user_round"
                            android:contentDescription="Informasi pribadi" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Informasi Pribadi"
                                android:textColor="#182D44"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Nama, tanggal lahir, jenis kelamin"
                                android:textColor="#63758A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Buka" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#DEE6F0" />

                    <!-- IDENTITAS DAN ALAMAT -->
                    <LinearLayout
                        android:id="@+id/itemIdentitasAlamat"
                        android:layout_width="match_parent"
                        android:layout_height="43dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="9dp"
                            android:background="@drawable/bg_icon_edit"
                            android:src="@drawable/ic_map_pin"
                            android:contentDescription="Alamat" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Identitas dan Alamat"
                                android:textColor="#182D44"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="NIK dan alamat tempat tinggal"
                                android:textColor="#63758A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Buka" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#DEE6F0" />

                    <!-- KONTAK AKUN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="43dp"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:padding="9dp"
                            android:background="@drawable/bg_icon_edit"
                            android:src="@drawable/ic_contact_round"
                            android:contentDescription="Kontak akun" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kontak Akun"
                                android:textColor="#182D44"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Email dan nomor HP"
                                android:textColor="#63758A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Buka" />

                    </LinearLayout>

                </LinearLayout>

                <!-- KETERANGAN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Perubahan nama tampilan tidak mengubah data identitas Anda."
                    android:textColor="#63758A"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <!-- TOMBOL SIMPAN -->
                <Button
                    android:id="@+id/btnSimpanPerubahan"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Simpan perubahan"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_edit"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- AREA NAVIGASI BAWAH -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#F5F7FC">

        <View
            android:layout_width="134dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_home_indicator" />

    </FrameLayout>

</LinearLayout>
