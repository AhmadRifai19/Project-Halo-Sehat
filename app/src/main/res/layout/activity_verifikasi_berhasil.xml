<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="292dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_success_header"
        android:paddingTop="12dp">

        <!-- Status Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9.41"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Logo -->
        <ImageView
            android:layout_width="131dp"
            android:layout_height="108dp"
            android:layout_marginTop="0dp"
            android:src="@drawable/logo_halo_sehat"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Halo Sehat" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Halo Sehat"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Layanan Kesehatan Dalam Genggaman"
            android:textColor="#DFEDFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- CONTENT -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <!-- SUCCESS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_success_card">

            <!-- SUCCESS ILLUSTRATION -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bg_success_glow"
                    android:scaleType="fitCenter"
                    android:contentDescription="Ilustrasi keberhasilan" />

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_success_check"
                    android:scaleType="fitCenter"
                    android:contentDescription="Tanda centang berhasil" />

            </FrameLayout>

            <!-- SUCCESS MESSAGE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Verifikasi Berhasil"
                android:textColor="#182D44"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Verifikasi selesai. Silakan kembali ke Login."
                android:textColor="#63758A"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnKembaliLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_success_button"
                android:text="Kembali ke Login"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </FrameLayout>

    <!-- HOME INDICATOR -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:foregroundGravity="center">

        <View
            android:layout_width="134dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_home_indicator" />

    </FrameLayout>

</LinearLayout>