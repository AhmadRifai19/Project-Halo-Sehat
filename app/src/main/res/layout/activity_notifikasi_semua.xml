<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="#2879C7">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="9.41"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="●  Wi-Fi  ▰"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifikasi"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pengingat antrean, jadwal kontrol, dan kesehatan Anda."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- DAFTAR NOTIFIKASI -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- INFORMASI JUMLAH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Waktu kirim belum tersedia"
                    android:textColor="#63758A"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 sudah dibaca"
                    android:textColor="#2879C7"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- NOTIFIKASI 1 -->
            <include
                layout="@layout/item_notif_antrean_dibaca" />

            <!-- NOTIFIKASI 2 -->
            <include
                layout="@layout/item_notif_jadwal_dibaca" />

            <!-- NOTIFIKASI 3 -->
            <include
                layout="@layout/item_notif_waktu_dibaca" />

            <!-- NOTIFIKASI 4 -->
            <include
                layout="@layout/item_notif_kesehatan_dibaca" />

        </LinearLayout>
    </ScrollView>

    <!-- STATUS SEMUA SUDAH DIBACA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Semua notifikasi sudah dibaca"
            android:textColor="#475569"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notif_semua_selesai" />
    </LinearLayout>

    <!-- NAVIGASI BAWAH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="vertical"
        android:background="#F0F1FD">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂\nBeranda"
                android:textColor="#63758A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🤖\nAI Konsul"
                android:textColor="#63758A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♧\nNotifikasi"
                android:textColor="#63758A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="●\nProfile"
                android:textColor="#63758A"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="206dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_notif_semua_indicator" />
    </LinearLayout>

</LinearLayout>
