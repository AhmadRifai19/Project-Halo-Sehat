<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:orientation="vertical"
        android:background="@drawable/bg_recovery_header"
        android:elevation="3dp">

        <!-- Status perangkat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Gunakan status bar Android asli untuk ikon sistem -->
        </LinearLayout>

        <!-- Navigasi kembali -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Kembali"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Judul halaman -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sandi Baru"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tetapkan sandi baru untuk akun Anda setelah verifikasi OTP divider."
                android:textColor="#DFEDFF"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- LOGO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:gravity="center">

        <ImageView
            android:layout_width="131dp"
            android:layout_height="108dp"
            android:src="@drawable/logo_halo_sehat"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Halo Sehat" />

    </LinearLayout>

    <!-- KONTEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- KARTU FORM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_new_password_card"
            android:elevation="2dp">

            <!-- Kata sandi baru -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kata sandi baru"
                android:textColor="#182D44"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_new_password_input"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Minimal 8 karakter"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:textColor="#182D44"
                    android:textColorHint="#63758A"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnShowNewPassword"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Tampilkan sandi"
                    android:src="@drawable/ic_eye_off" />

            </LinearLayout>

            <!-- Konfirmasi sandi -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Konfirmasi kata sandi"
                android:textColor="#182D44"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_new_password_input"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Ulangi kata sandi"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:textColor="#182D44"
                    android:textColorHint="#63758A"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnShowConfirmPassword"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Tampilkan konfirmasi sandi"
                    android:src="@drawable/ic_eye_off" />

            </LinearLayout>

            <!-- Tombol simpan -->
            <Button
                android:id="@+id/btnSavePassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_new_password_button"
                android:stateListAnimator="@null"
                android:text="Simpan Sandi"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- AREA AMAN PERANGKAT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"/>

</LinearLayout>