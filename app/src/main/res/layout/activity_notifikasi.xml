<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="#2879C7"
        android:elevation="6dp">

        <!-- Status bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="9.41"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="●  Wi-Fi  ▰"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifikasi"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pengingat antrean, jadwal kontrol, dan kesehatan Anda."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- DAFTAR NOTIFIKASI -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Informasi waktu dan jumlah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Waktu kirim belum tersedia"
                    android:textColor="#63758A"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 belum dibaca"
                    android:textColor="#2879C7"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- NOTIFIKASI 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_notif_icon"
                    android:contentDescription="Ikon antrean" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Antrean"
                            android:textColor="#2879C7"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_category" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Belum dibaca"
                            android:textColor="#182D44"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_status" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Antrean Segera Dipanggil"
                        android:textColor="#182D44"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Antrean A23 dipanggil dua nomor lagi. Bersiaplah menuju ruang pemeriksaan."
                        android:textColor="#495C72"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- NOTIFIKASI 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="82dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_notif_icon"
                    android:contentDescription="Ikon jadwal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Jadwal"
                            android:textColor="#2879C7"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_category" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Belum dibaca"
                            android:textColor="#182D44"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_status" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Jadwal Kontrol"
                        android:textColor="#182D44"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Jadwal kontrol: 26 Mei 2026 pukul 09.00 WIB."
                        android:textColor="#495C72"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- NOTIFIKASI 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="118dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_notif_icon"
                    android:contentDescription="Ikon waktu tunggu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Antrean"
                            android:textColor="#2879C7"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_category" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Belum dibaca"
                            android:textColor="#182D44"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_status" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Estimasi Waktu Tunggu"
                        android:textColor="#182D44"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sisa antrean sekitar 15 menit. Bersiaplah ke ruang pemeriksaan agar pelayanan cepat dan tertib."
                        android:textColor="#495C72"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- NOTIFIKASI 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="118dp"
                android:orientation="horizontal"
                android:padding="10dp"
                android:background="@drawable/bg_notif_card">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_notif_icon"
                    android:contentDescription="Ikon kesehatan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Kesehatan"
                            android:textColor="#2879C7"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_category" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Belum dibaca"
                            android:textColor="#182D44"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_notif_status" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tips Kesehatan Harian"
                        android:textColor="#182D44"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Kurangi gadget sebelum tidur. Tidur 7–8 jam setiap malam agar tubuh segar, fokus, dan kesehatan terjaga."
                        android:textColor="#495C72"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- TOMBOL TANDAI SEMUA DIBACA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btn_tandai_dibaca"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Tandai semua sudah dibaca"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_notif_button" />
    </LinearLayout>

    <!-- NAVIGASI BAWAH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="vertical"
        android:background="#F0F1FD"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="4">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⌂\nBeranda"
                android:textColor="#63758A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🤖\nAI Konsul"
                android:textColor="#63758A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♧\nNotifikasi"
                android:textColor="#63758A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="●\nProfile"
                android:textColor="#63758A"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="206dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_notif_home_indicator" />
    </LinearLayout>

</LinearLayout>
