<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_gravity="bottom"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/navBeranda"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="Beranda"
        android:textColor="#8291A5"
        android:textSize="11sp"
        app:drawableTint="#8291A5"
        app:drawableTopCompat="@drawable/ic_nav_home" />

    <TextView
        android:id="@+id/navAiKonsul"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="AI Konsul"
        android:textColor="#8291A5"
        android:textSize="11sp"
        app:drawableTint="#8291A5"
        app:drawableTopCompat="@drawable/ic_nav_ai" />

    <TextView
        android:id="@+id/navNotifikasi"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="Notifikasi"
        android:textColor="#8291A5"
        android:textSize="11sp"
        app:drawableTint="#8291A5"
        app:drawableTopCompat="@drawable/ic_nav_notif" />

    <TextView
        android:id="@+id/navProfile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:text="Profile"
        android:textColor="#8291A5"
        android:textSize="11sp"
        app:drawableTint="#8291A5"
        app:drawableTopCompat="@drawable/ic_nav_profile" />

</LinearLayout>