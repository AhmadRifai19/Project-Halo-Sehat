<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC"
    tools:context=".MainActivity">

    <!-- Wadah tempat ke-4 Fragment berganti-ganti -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- NAVIGASI BAWAH MINIMALIS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- Garis pembatas tipis di atas bottom bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6ECF5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:weightSum="4">

            <TextView
                android:id="@+id/navBeranda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:drawablePadding="3dp"
                android:text="Beranda"
                android:textColor="#2879C7"
                android:textStyle="bold"
                android:textSize="11sp"
                app:drawableTopCompat="@drawable/ic_nav_home"
                app:drawableTint="#2879C7" />

            <TextView
                android:id="@+id/navAiKonsul"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:drawablePadding="3dp"
                android:text="AI Konsul"
                android:textColor="#63758A"
                android:textSize="11sp"
                app:drawableTopCompat="@drawable/ic_nav_ai"
                app:drawableTint="#63758A" />

            <TextView
                android:id="@+id/navNotifikasi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:drawablePadding="3dp"
                android:text="Notifikasi"
                android:textColor="#63758A"
                android:textSize="11sp"
                app:drawableTopCompat="@drawable/ic_nav_notif"
                app:drawableTint="#63758A" />

            <TextView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:drawablePadding="3dp"
                android:text="Profile"
                android:textColor="#63758A"
                android:textSize="11sp"
                app:drawableTopCompat="@drawable/ic_nav_profile"
                app:drawableTint="#63758A" />
        </LinearLayout>

        <View
            android:layout_width="134dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_notif_home_indicator" />
    </LinearLayout>

</LinearLayout>