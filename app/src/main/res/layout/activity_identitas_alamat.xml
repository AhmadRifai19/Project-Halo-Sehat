<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER BIRU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="194dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:background="@drawable/bg_header_identitas">

            <TextView
                android:id="@+id/btnBackIdentitas"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="‹"
                android:textSize="32sp"
                android:textColor="#FFFFFF"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Kembali"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Identitas dan Alamat"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kelola identitas serta alamat tempat tinggal Anda."
                android:textSize="14sp"
                android:textColor="#DFF0FF"/>

        </LinearLayout>

        <!-- KONTEN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- CATATAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/bg_note_identitas">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="ⓘ"
                    android:textSize="18sp"
                    android:textColor="#2879C7"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Data identitas belum diisi. NIK di bawah hanya placeholder, bukan nomor identitas nyata."
                    android:textSize="12sp"
                    android:textColor="#185FA5"/>

            </LinearLayout>

            <!-- IDENTITAS KEPENDUDUKAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_panel_identitas">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Identitas kependudukan"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Nomor Induk Kependudukan (NIK)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <EditText
                    android:id="@+id/etNIK"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input_identitas"
                    android:hint="•••• •••• •••• ••••"
                    android:textSize="14sp"
                    android:textColor="#182D44"
                    android:textColorHint="#63758A"
                    android:inputType="numberPassword"
                    android:maxLength="16"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Masukkan 16 digit NIK milik Anda."
                    android:textSize="11sp"
                    android:textColor="#63758A"/>

            </LinearLayout>

            <!-- ALAMAT TEMPAT TINGGAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_panel_identitas">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alamat tempat tinggal"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <!-- ALAMAT LENGKAP -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Alamat lengkap"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <EditText
                    android:id="@+id/etAlamatLengkap"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:layout_marginTop="8dp"
                    android:padding="14dp"
                    android:gravity="top"
                    android:background="@drawable/bg_input_identitas"
                    android:hint="Isi nama jalan, nomor rumah, RT/RW"
                    android:textSize="14sp"
                    android:textColor="#182D44"
                    android:textColorHint="#63758A"
                    android:inputType="textMultiLine"/>

                <!-- PROVINSI -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Provinsi"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <Spinner
                    android:id="@+id/spProvinsi"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_identitas"
                    android:spinnerMode="dropdown"
                    android:paddingStart="10dp"
                    android:entries="@array/pilihan_provinsi"/>

                <!-- KOTA / KABUPATEN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Kota / Kabupaten"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <Spinner
                    android:id="@+id/spKota"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_identitas"
                    android:spinnerMode="dropdown"
                    android:paddingStart="10dp"
                    android:entries="@array/pilihan_kota"/>

                <!-- KECAMATAN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Kecamatan"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <Spinner
                    android:id="@+id/spKecamatan"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_identitas"
                    android:spinnerMode="dropdown"
                    android:paddingStart="10dp"
                    android:entries="@array/pilihan_kecamatan"/>

                <!-- KELURAHAN / DESA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Kelurahan / Desa"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <Spinner
                    android:id="@+id/spKelurahan"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_identitas"
                    android:spinnerMode="dropdown"
                    android:paddingStart="10dp"
                    android:entries="@array/pilihan_kelurahan"/>

                <!-- KODE POS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Kode pos"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#182D44"/>

                <EditText
                    android:id="@+id/etKodePos"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input_identitas"
                    android:hint="Masukkan 5 digit kode pos"
                    android:textSize="14sp"
                    android:textColor="#182D44"
                    android:textColorHint="#63758A"
                    android:inputType="number"
                    android:maxLength="5"/>

            </LinearLayout>

            <!-- TOMBOL SIMPAN -->
            <Button
                android:id="@+id/btnSimpanIdentitas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Simpan identitas dan alamat"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_identitas"
                android:backgroundTint="@null"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
