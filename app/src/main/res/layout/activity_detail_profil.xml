<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FC">

    <TextView
        android:id="@+id/tvDetailJudul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Detail Profil"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#182D44"/>

    <TextView
        android:id="@+id/tvDetailDeskripsi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Informasi akun Anda"
        android:textSize="15sp"
        android:textColor="#63758A"/>

    <Button
        android:id="@+id/btnEditProfil"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="Edit Profil"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:backgroundTint="#2879C7"/>


</LinearLayout>